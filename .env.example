APP_NAME="Visit Tur"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
# Tur saatleri yerel saatle tutulur (kalkış 05:30 ise 05:30'da "geçmiş" sayılır).
APP_TIMEZONE=Europe/Istanbul
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# --- İlk yönetici hesabı (yalnız ilk "db:seed" sırasında kullanılır) ---
# Canlıda zayıf parola kabul edilmez. Hesap oluştuktan sonra bu iki satırı silebilirsiniz.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Site iletişim ayarları (admin panelindeki Site Ayarları boş bırakılırsa bu değerler kullanılır) ---
SITE_PHONE="+90 500 000 00 00"
SITE_WHATSAPP="905000000000"
SITE_EMAIL="info@example.com"
SITE_NOTIFICATION_EMAIL=

# --- SEO & AI otomasyonu ---
# OpenRouter anahtarı (https://openrouter.ai/keys). Boşsa AI aksiyonları panelde gizlenir.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
AI_TIMEOUT=180
AI_MAX_TOKENS=8000
AI_TEMPERATURE=0.7

# Google Search Console (isteğe bağlı). Mülk tipi GSC'dekiyle BİREBİR aynı olmalı.
# Örnek: sc-domain:ornek.com   VEYA   https://ornek.com/
GOOGLE_APPLICATION_CREDENTIALS=
GSC_PROPERTY=

# Otomasyon günlüğü (storage/logs/automation.log)
AUTOMATION_LOG_LEVEL=debug
AUTOMATION_LOG_DAYS=14

# --- Google reCAPTCHA ---
# Anahtarlar sürüme özeldir. Google'dan hangi sürümü aldıysanız RECAPTCHA_VERSION
# onu göstermeli: v3 (görünmez, puan tabanlı) veya v2 ("Ben robot değilim" kutucuğu).
# İkisinden biri boşsa doğrulama devre dışı kalır ve form normal çalışır.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERSION=v3
# v3 için geçme eşiği (0.0-1.0). Düşürürsen daha çok gönderim geçer.
RECAPTCHA_MIN_SCORE=0.5
